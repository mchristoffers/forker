# Generated by forker. Each target delegates to its own script in forker/.
.PHONY: build publish update service-install service-uninstall service-status

build:
	bash forker/build.sh

publish:
	bash forker/publish.sh $(VERSION)

update:
	bash forker/update.sh

# Daily `update` via a systemd user timer.
service-install:
	bash forker/service.sh install

service-uninstall:
	bash forker/service.sh uninstall

service-status:
	bash forker/service.sh status
